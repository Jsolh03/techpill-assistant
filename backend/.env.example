# Copia este archivo a ".env" y ajusta los valores si lo necesitas.

# URL base donde escucha Ollama (por defecto en local)
OLLAMA_BASE_URL=http://localhost:11434

# Modelo de Ollama que usaras por defecto
OLLAMA_MODEL=qwen2.5-coder:7b

# Origenes permitidos para CORS (el frontend de React/Vite)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
